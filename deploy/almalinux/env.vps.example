# Copie para /opt/portal-myblue/.env (dono: portal, permissão 600) e preencha.

# Postgres na própria VPS (usuário e banco criados no passo 4 do LEIAME)
DATABASE_URL=postgres://portal:TROQUE_A_SENHA@127.0.0.1:5432/portal_myblue

# O portal só atende a própria máquina; o Nginx (ou Apache) recebe a internet
HOST=127.0.0.1
PORT=3000
# HTTPS feito pelo Nginx/Apache na frente
TRUST_PROXY=1
COOKIE_SECURE=true

# Endereço público (link "Abrir no portal" dos e-mails)
PORTAL_URL=https://portal.myblue.com.br

# Primeiro administrador (vale só com o banco vazio; senha vazia = temporária no log)
ADMIN_EMAIL=admin@myblue.com.br
ADMIN_NOME=Administrador
ADMIN_SENHA=

SESSAO_HORAS=12

# E-mail dos avisos (os mesmos valores usados hoje no Railway)
EMAIL_REMETENTE="Portal MyBlue <naoresponda@myblue.com.br>"
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

LIMITE_ANEXO_MB=10
LIMITE_FUNDO_MB=8
