# Porta HTTP do portal
PORT=3000

# Pasta onde ficam o banco (myblue.db) e os HTMLs enviados
DATA_DIR=./data

# Primeiro administrador (criado só se ainda não houver nenhum usuário)
ADMIN_EMAIL=admin@myblue.com.br
ADMIN_NOME=Administrador
# Se ficar vazio, uma senha aleatória é gerada e mostrada no log na primeira execução
ADMIN_SENHA=

# Duração da sessão (horas)
SESSAO_HORAS=12

# Use "true" quando o portal estiver atrás de HTTPS (cookie Secure)
COOKIE_SECURE=false

# Use "1" quando houver um proxy reverso (Nginx, Render, Railway…) na frente
TRUST_PROXY=0
