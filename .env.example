# Copie para .env (no computador/servidor próprio) ou crie as variáveis no painel do Railway.

# Banco Postgres (Supabase: connection string do "Session pooler"; Railway: ${{Postgres.DATABASE_URL}})
# Sem ele, o portal usa um Postgres embutido gravado em DATA_DIR (bom para testes no computador).
DATABASE_URL=

# Primeiro administrador (usado só quando o banco ainda está vazio)
ADMIN_EMAIL=admin@myblue.com.br
ADMIN_NOME=Administrador
# Se ficar vazio, uma senha temporária é gerada e mostrada no log na primeira execução
ADMIN_SENHA=

# Duração da sessão (horas)
SESSAO_HORAS=12

# Central de Tickets: e-mail para quem recebe uma demanda (sem nada configurado, os avisos ficam só no portal)
# Endereço público do portal, usado no link "Abrir no portal" dos e-mails
PORTAL_URL=
# Caixa que envia os avisos (Microsoft 365: uma caixa compartilhada, ex.: naoresponda@myblue.com.br)
EMAIL_REMETENTE="Portal MyBlue <naoresponda@myblue.com.br>"
# Microsoft 365 (recomendado): aplicativo registrado no Entra ID, com Mail.Send liberado só para a caixa remetente (veja o README)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Alternativa: SMTP comum (só se não usar o Microsoft 365 acima)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_SENHA=
# Tamanho máximo de cada anexo de ticket (MB)
LIMITE_ANEXO_MB=10

# ---------------------------------------------------------------------------
# As variáveis abaixo NÃO devem ser criadas no Railway: lá o portal detecta
# sozinho o volume, a porta e o proxy HTTPS. Use só em servidor próprio.
# ---------------------------------------------------------------------------
# PORT=3000
# DATA_DIR=./data
# COOKIE_SECURE=true   # quando o portal estiver em HTTPS
# TRUST_PROXY=1        # quando houver proxy reverso (Nginx, Caddy) na frente
