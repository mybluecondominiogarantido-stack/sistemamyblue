# Copie para .env (no computador/servidor próprio) ou crie as variáveis no painel do Railway.

# Primeiro administrador (usado só quando o banco ainda está vazio)
ADMIN_EMAIL=admin@myblue.com.br
ADMIN_NOME=Administrador
# Se ficar vazio, uma senha temporária é gerada e mostrada no log na primeira execução
ADMIN_SENHA=

# Duração da sessão (horas)
SESSAO_HORAS=12

# ---------------------------------------------------------------------------
# As variáveis abaixo NÃO devem ser criadas no Railway: lá o portal detecta
# sozinho o volume, a porta e o proxy HTTPS. Use só em servidor próprio.
# ---------------------------------------------------------------------------
# PORT=3000
# DATA_DIR=./data
# COOKIE_SECURE=true   # quando o portal estiver em HTTPS
# TRUST_PROXY=1        # quando houver proxy reverso (Nginx, Caddy) na frente
